# Copy to .env (never commit .env). Needed only for the Friends feature.
# From your Supabase project: Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Strava (optional): see README → "Switching on Strava".
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_TOKEN_URL=https://YOUR-PROJECT.supabase.co/functions/v1/strava-token
