{
  "expo": {
    "name": "Steady",
    "slug": "steady-run",
    "scheme": "steady",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F4"
    },
    "ios": {
      "bundleIdentifier": "com.taylorhawkins13.steady",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"],
        "NSLocationWhenInUseUsageDescription": "Steady uses your location to record distance, pace and your route during runs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow “Always” so Steady can keep recording your run with the screen off or while you use other apps. Location is only used during a run."
      }
    },
    "android": {
      "package": "com.taylorhawkins13.steady",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_EXERCISE_ROUTE",
        "android.permission.health.WRITE_DISTANCE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": { "compileSdkVersion": 36, "targetSdkVersion": 36, "minSdkVersion": 26 }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Steady uses your location to record distance, pace and your route during runs.",
          "locationAlwaysAndWhenInUsePermission": "Allow “Always” so Steady can keep recording your run with the screen off. Location is only used during a run.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F7D62"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Steady reads heart rate, resting heart rate and sleep to show post-run heart rate and suggest easier days when you need them.",
          "healthUpdatePermission": "Steady saves your completed runs and strength sessions as workouts."
        }
      ],
      "react-native-health-connect"
    ]
  }
}
