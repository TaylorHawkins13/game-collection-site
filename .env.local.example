# Copy this file to .env.local and fill in your own values.
# Get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables the "Search" auto-fill button when adding games.
# Free — from a Twitch developer app (dev.twitch.tv/console/apps).
# NOT prefixed with NEXT_PUBLIC_ — these stay server-side only, never
# sent to the browser. See README.md for the full setup steps.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: enables the "Check eBay price" button on items.
# Free — from an eBay developer account (developer.ebay.com/join).
# NOT prefixed with NEXT_PUBLIC_ — these stay server-side only, never
# sent to the browser. See README.md for the full setup steps.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: enables "Log in with Steam" and "Import from Steam".
# Free — from a Steam Web API key (steamcommunity.com/dev/apikey).
# NOT prefixed with NEXT_PUBLIC_ — stays server-side only, never sent
# to the browser. Steam login only works on the real deployed domain
# set in lib/siteUrl.js, not on localhost. See README.md for details.
STEAM_API_KEY=

# Optional: turns on Google AdSense ads (Auto ads) site-wide, behind a
# cookie-consent banner. From your AdSense account's site settings —
# looks like "ca-pub-XXXXXXXXXXXXXXXX". This one IS prefixed with
# NEXT_PUBLIC_ since it needs to reach the browser to load the ad script.
# See README.md for the full AdSense signup walkthrough.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional: sends a feedback-notification email and enables the private
# new-feature newsletter admin page. Free tier at resend.com covers a
# personal site easily. NOT prefixed with NEXT_PUBLIC_ — server-side
# only. See README.md step 7 for the full setup steps.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# The email you sign into Shelf Life with — gates /admin/newsletter and
# is where feedback notifications go by default.
ADMIN_EMAIL=
# Optional: send feedback notifications to a different address than
# ADMIN_EMAIL instead. Falls back to ADMIN_EMAIL if left blank.
FEEDBACK_NOTIFY_EMAIL=
# Only needed to actually send the newsletter (not for feedback emails).
# From Supabase Settings -> API Keys -> service_role.
# WARNING: this key bypasses Row Level Security entirely — never expose
# it to the browser, never commit it, server-side use only.
SUPABASE_SERVICE_ROLE_KEY=
